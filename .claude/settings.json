      "Bash(mise exec -- bash scripts/check-package-contents.sh)",
      "Bash(sh scripts/verify-before-push.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git rebase origin/main)",
      "Bash(git rebase --continue)",
      "Bash(GIT_EDITOR=true git rebase --continue)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh run:*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh issue:*)"
    ],
    "ask": [
      "Edit(.github/**)",
      "Write(.github/**)",
      "Edit(scripts/configure-repo.sh)",
      "Write(scripts/configure-repo.sh)",
      "Edit(SECURITY.md)",
      "Write(SECURITY.md)",
      "Edit(LICENSE)",
      "Write(LICENSE)",
      "Edit(package.json)",
      "Write(package.json)",
      "Edit(mise.toml)",
      "Write(mise.toml)",
      "Bash(git push* main*)",
      "Bash(git push*:main*)",
      "Bash(git push*:refs/heads/main*)",
      "Bash(git push* master*)",
      "Bash(git push*:master*)",
      "Bash(git push*:refs/heads/master*)"
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f*)",
